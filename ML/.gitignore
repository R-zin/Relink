# Python
__pycache__/
*.pyc
.pytest_cache/

# Generated/processed ML data
data/processed/
data/raw/*/sentinel/*.tif
data/raw/*/dem/*.tif
data/raw/*/rainfall/
data/raw/*/landcover/*.tif

# Raw downloaded archives & their extracts (re-downloadable, large)
data/raw/_kerala_inventory_extract/
data/raw/*.zip

# Generated large rasters (regenerable, too big for git)
outputs/*/susceptibility.tif
outputs/*/risk_classes.tif

# Keep useful small/vector files (incl. map overlay GeoJSON for app integration)
!data/raw/*/landslides/
!data/raw/*/landslides/*.geojson
!data/regions/
!data/regions/**/*.geojson