# Phase 1 (required): local Postgres or Supabase direct connection.
# Async driver is used by the app; asyncpg URL form: postgresql+asyncpg://user:pass@host:5432/relink
# Supabase note: use the session-mode pooler (port 5432) and append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/relink

# Tests use this database (created/dropped by the test harness); keep separate from dev DB.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/relink_test

# Seed script demo-region center (default: Kochi, Kerala)
SEED_CENTER_LAT=9.98
SEED_CENTER_LNG=76.28

# --- Later phases (pass-throughs; optional in Phase 1) ---
SUPABASE_URL=            # Phase 4: Supabase project URL (realtime/auth)
SUPABASE_KEY=            # Phase 4: Supabase anon/service key
FCM_SERVER_KEY=          # Phase 4: Firebase Cloud Messaging server key (alert push)
LLM_API_KEY=             # Phase 4: Claude/LLM API key for AI risk review
MEDICAL_CARD_DEMO_KEY=   # Phase 3: AES-256-GCM pre-shared medical-card demo key (app build + responder demo only)
OPEN_METEO_BASE_URL=https://api.open-meteo.com   # Phase 4: GloFAS/forecast/marine APIs
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3 # Phase 4: global cyclone/event feed
SACHET_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_kerala.xml  # Phase 4: NDMA Sachet alerts (replace <state>)
